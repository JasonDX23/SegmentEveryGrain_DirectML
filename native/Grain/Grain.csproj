<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Grain</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SegmentEveryGrain</AssemblyName>
    <ApplicationIcon>Assets\Grain.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4654" />
    <Content Include="Assets\Grain.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Backend\worker.py" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Backend\progress.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The CLI publish pipeline does not collect these unpackaged XAML outputs. -->
  <Target Name="PublishNativeXamlResources" AfterTargets="Publish">
    <ItemGroup><NativeXamlAssets Include="$(TargetDir)*.xbf;$(TargetDir)$(AssemblyName).pri" /></ItemGroup>
    <Copy SourceFiles="@(NativeXamlAssets)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
    <Error Condition="!Exists('$(PublishDir)$(AssemblyName).pri')" Text="The native XAML resource index was not published." />
  </Target>
</Project>
