<Application x:Class="Grain.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries><XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls"/></ResourceDictionary.MergedDictionaries>
   <Color x:Key="SystemAccentColor">#176B59</Color>
   <SolidColorBrush x:Key="AccentBrush" Color="#176B59"/>
   <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#176B59"/>
   <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#227866"/>
   <SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#358674"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOn" Color="#176B59"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOnPointerOver" Color="#227866"/>
   <SolidColorBrush x:Key="ToggleSwitchFillOnPressed" Color="#358674"/>
   <SolidColorBrush x:Key="ToggleSwitchStrokeOn" Color="#176B59"/>
   <SolidColorBrush x:Key="AccentButtonBackground" Color="#176B59"/>
   <SolidColorBrush x:Key="AccentButtonBackgroundPointerOver" Color="#227866"/>
   <SolidColorBrush x:Key="AccentButtonBackgroundPressed" Color="#358674"/>
   <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="#176B59"/>
   <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="#227866"/>
   <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#358674"/>
   <SolidColorBrush x:Key="QuietBrush" Color="#66766E"/>
   <Style x:Key="Eyebrow" TargetType="TextBlock">
    <Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="140"/><Setter Property="Foreground" Value="#6D7D73"/>
   </Style>
   <Style x:Key="SectionTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="15"/><Setter Property="FontWeight" Value="SemiBold"/>
   </Style>
   <Style TargetType="Button"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="12,9"/></Style>
   <Style TargetType="ToggleButton"><Setter Property="CornerRadius" Value="7"/><Setter Property="Padding" Value="10,9"/></Style>
  </ResourceDictionary>
 </Application.Resources>
</Application>
